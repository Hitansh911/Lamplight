# Copy to .env and fill in ONE provider, or skip entirely to use built-in replies.
# Load it with:  set -a; source .env; set +a   (or export the variables yourself)

# auto | anthropic | openai | gemini | groq | ollama | offline
LLM_PROVIDER=auto

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional: override the default model for the chosen provider
# LLM_MODEL=claude-haiku-5-5

# Ollama (fully local, nothing leaves your computer)
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# LLM_MODEL=llama3.2

# Optional: where the journal database lives
# LAMPLIGHT_DB=./data/journal.db
